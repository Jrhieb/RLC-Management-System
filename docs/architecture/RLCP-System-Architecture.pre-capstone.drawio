  <diagram id="rlcp-6" name="Process Flow of the Proposed System">
    <mxGraphModel page="1" pageScale="1" pageWidth="2600" pageHeight="1600" background="#FFFFFF" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Process Flow of the Proposed System" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#292929;strokeColor=#A50021;fillColor=#FFFDF8;fillColor=#A50021;fontColor=#FFFFFF;fontSize=32;fontStyle=1;align=left;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="2540" height="64" as="geometry" />
        </mxCell>
        <mxCell id="description" value="Lanes identify responsibility. Staff onboarding is separate from beneficiary records. Attendance, assistance and reporting are independent choices; none requires another." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#292929;strokeColor=#A50021;fillColor=#FFFDF8;text;strokeColor=none;fillColor=none;align=left;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="2520" height="65" as="geometry" />
        </mxCell>
        <mxCell id="onboard" value="A · Staff onboarding and approval" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#292929;strokeColor=#A50021;fillColor=#FFFDF8;text;strokeColor=none;fillColor=none;align=left;fontSize=26;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="2500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="applicant" value="Staff Applicant" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#292929;strokeColor=#A50021;fillColor=#FFFDF8;swimlane;horizontal=0;startSize=190;container=1;collapsible=0;fillColor=#FFF5DE;fontStyle=1;fontSize=22;strokeColor=#D4A039;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="2520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="systemA" value="RLCP system / mail worker" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#292929;strokeColor=#A50021;fillColor=#FFFDF8;swimlane;horizontal=0;startSize=190;container=1;collapsible=0;fillColor=#FFF5DE;fontStyle=1;fontSize=22;strokeColor=#D4A039;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="2520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="directorA" value="Director" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#292929;strokeColor=#A50021;fillColor=#FFFDF8;swimlane;horizontal=0;startSize=190;container=1;collapsible=0;fillColor=#FFF5DE;fontStyle=1;fontSize=22;strokeColor=#D4A039;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="2520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="request" value="Request registration&#10;email link" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#292929;strokeColor=#A50021;fillColor=#FFFDF8;rounded=1;fillColor=#FFFFFF;fontSize=20;" vertex="1" parent="applicant">
          <mxGeometry x="230" y="35" width="310" height="85" as="geometry" />
        </mxCell>
        <mxCell id="verify" value="Follow email link;&#10;complete registration" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#292929;strokeColor=#A50021;fillColor=#FFFDF8;rounded=1;fillColor=#FFFFFF;fontSize=20;" vertex="1" parent="applicant">
          <mxGeometry x="720" y="35" width="310" height="85" as="geometry" />
        </mxCell>
        <mxCell id="queue" value="Save request; queue&#10;verification email" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#292929;strokeColor=#A50021;fillColor=#FFFDF8;rounded=1;fillColor=#FFFFFF;fontSize=20;" vertex="1" parent="systemA">
          <mxGeometry x="230" y="45" width="310" height="85" as="geometry" />
        </mxCell>
        <mxCell id="pending" value="Consume link + session;&#10;create pending User; notify" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#292929;strokeColor=#A50021;fillColor=#FFFDF8;rounded=1;fillColor=#FFFFFF;fontSize=20;" vertex="1" parent="systemA">
          <mxGeometry x="720" y="45" width="310" height="85" as="geometry" />
        </mxCell>
        <mxCell id="review" value="Review pending account;&#10;confirm decision" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#292929;strokeColor=#A50021;fillColor=#FFFDF8;rounded=1;fillColor=#FFFFFF;fontSize=20;" vertex="1" parent="directorA">
          <mxGeometry x="1220" y="35" width="310" height="85" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="Approve?" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#292929;strokeColor=#A50021;fillColor=#FFFDF8;rhombus;fillColor=#FFFFFF;fontSize=20;" vertex="1" parent="directorA">
          <mxGeometry x="1690" y="25" width="240" height="105" as="geometry" />
        </mxCell>
        <mxCell id="approve" value="Approved: enable&#10;verified staff access" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#292929;strokeColor=#A50021;fillColor=#FFFDF8;rounded=1;fillColor=#FFFFFF;fontSize=20;" vertex="1" parent="systemA">
          <mxGeometry x="2130" y="20" width="320" height="65" as="geometry" />
        </mxCell>
        <mxCell id="reject" value="Rejected: retain&#10;restricted account" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#292929;strokeColor=#A50021;fillColor=#FFFDF8;rounded=1;fillColor=#FFFFFF;fontSize=20;" vertex="1" parent="systemA">
          <mxGeometry x="2130" y="105" width="320" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="submit" source="request" target="queue" parent="1" edge="1" style="html=1;fontFamily=Arial;fontSize=18;fontColor=#292929;strokeColor=#555555;strokeWidth=2;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;endArrow=block;">
