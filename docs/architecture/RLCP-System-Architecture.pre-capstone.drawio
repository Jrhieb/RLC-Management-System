        <mxCell id="s0-m0" value="1. Applicant requests email link" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1579;entryX=0.5;entryY=0.1579;fontSize=19;fontFamily=Arial;fontColor=#292929;strokeColor=#A50021;" edge="1" parent="1" source="s0-a" target="s0-b">
