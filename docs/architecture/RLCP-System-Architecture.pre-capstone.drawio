        </mxCell>
        <mxCell id="description" value="Four independent scenarios; time runs downward within each panel. Solid arrows: synchronous messages. Dashed arrows: queued dispatch or return, as labeled." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#292929;strokeColor=#A50021;fillColor=#FFFDF8;text;strokeColor=none;fillColor=none;align=left;fontSize=22;" vertex="1" parent="1">
