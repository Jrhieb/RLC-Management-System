        <mxCell id="title" value="Sequence Diagram of the Proposed System" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#292929;strokeColor=#A50021;fillColor=#FFFDF8;fillColor=#A50021;fontColor=#FFFFFF;fontSize=32;fontStyle=1;align=left;spacingLeft=20;" vertex="1" parent="1">
