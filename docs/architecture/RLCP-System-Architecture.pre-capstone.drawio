        <mxCell id="s2-m1" value="2. Authorize active beneficiary; validate" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.3462;entryX=0.5;entryY=0.3462;fontSize=19;fontFamily=Arial;fontColor=#292929;strokeColor=#A50021;" edge="1" parent="1" source="s2-b" target="s2-c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2-m2" value="3. Find token; create if absent" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.4615;entryX=0.5;entryY=0.4615;fontSize=19;fontFamily=Arial;fontColor=#292929;strokeColor=#A50021;" edge="1" parent="1" source="s2-b" target="s2-d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2-m3" value="4. New row / existing token&#10;Unique race: reread existing row" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0.5;exitY=0.5769;entryX=0.5;entryY=0.5769;fontSize=19;fontFamily=Arial;fontColor=#292929;strokeColor=#A50021;" edge="1" parent="1" source="s2-d" target="s2-b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2-m4" value="5. ALT repeat: compare all fields&#10;including recorder + UTC release time" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.6923;entryX=0.5;entryY=0.6923;fontSize=19;fontFamily=Arial;fontColor=#292929;strokeColor=#A50021;" edge="1" parent="1" source="s2-b" target="s2-c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2-m5" value="6. Same: reuse; no duplicate&#10;Different: validation error" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0.5;exitY=0.8077;entryX=0.5;entryY=0.8077;fontSize=19;fontFamily=Arial;fontColor=#292929;strokeColor=#A50021;" edge="1" parent="1" source="s2-b" target="s2-a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="seq-note2" value="Each replay repeats authorization. No attendance prerequisite; this records a release, not payment." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#292929;strokeColor=#A50021;fillColor=#FFFDF8;text;strokeColor=none;fillColor=none;align=left;fontSize=19;" vertex="1" parent="1">
          <mxGeometry x="40" y="1970" width="1400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="seq-title3" value="D · CSV / PDF report export" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#292929;strokeColor=#A50021;fillColor=#FFFDF8;text;strokeColor=none;fillColor=none;align=left;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="1530" y="1125" width="1410" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s3-a" value="Staff browser" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=70;fontSize=19;fontFamily=Arial;fontColor=#292929;strokeColor=#A50021;" vertex="1" parent="1">
          <mxGeometry x="1535.0" y="1205.0" width="260" height="520" as="geometry" />
        </mxCell>
        <mxCell id="s3-b" value="Report export controllers" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=70;fontSize=19;fontFamily=Arial;fontColor=#292929;strokeColor=#A50021;" vertex="1" parent="1">
          <mxGeometry x="1865.0" y="1205.0" width="260" height="520" as="geometry" />
        </mxCell>
        <mxCell id="s3-c" value="Scoped models" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=70;fontSize=19;fontFamily=Arial;fontColor=#292929;strokeColor=#A50021;" vertex="1" parent="1">
          <mxGeometry x="2195.0" y="1205.0" width="260" height="520" as="geometry" />
        </mxCell>
        <mxCell id="s3-d" value="ExportRows /&lt;br&gt;Dompdf" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=70;fontSize=19;fontFamily=Arial;fontColor=#292929;strokeColor=#A50021;" vertex="1" parent="1">
          <mxGeometry x="2525.0" y="1205.0" width="260" height="520" as="geometry" />
        </mxCell>
        <mxCell id="s3-m0" value="1. Request CSV or PDF; type + dates" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.2308;entryX=0.5;entryY=0.2308;fontSize=19;fontFamily=Arial;fontColor=#292929;strokeColor=#A50021;" edge="1" parent="1" source="s3-a" target="s3-b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3-m1" value="2. Authorize; validate dates; query&#10;current role / assignment scope" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.3462;entryX=0.5;entryY=0.3462;fontSize=19;fontFamily=Arial;fontColor=#292929;strokeColor=#A50021;" edge="1" parent="1" source="s3-b" target="s3-c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3-m2" value="3. Attendance or assistance rows" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0.5;exitY=0.4615;entryX=0.5;entryY=0.4615;fontSize=19;fontFamily=Arial;fontColor=#292929;strokeColor=#A50021;" edge="1" parent="1" source="s3-c" target="s3-b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3-m3" value="4. ALT CSV: stream safe cells&#10;ELSE PDF &lt;= 1,000: render view" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.5769;entryX=0.5;entryY=0.5769;fontSize=19;fontFamily=Arial;fontColor=#292929;strokeColor=#A50021;" edge="1" parent="1" source="s3-b" target="s3-d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3-m4" value="5. ALT PDF &gt; 1,000: validation error" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0.5;exitY=0.6923;entryX=0.5;entryY=0.6923;fontSize=19;fontFamily=Arial;fontColor=#292929;strokeColor=#A50021;" edge="1" parent="1" source="s3-b" target="s3-a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3-m5" value="6. Download; private, no-store" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0.5;exitY=0.8077;entryX=0.5;entryY=0.8077;fontSize=19;fontFamily=Arial;fontColor=#292929;strokeColor=#A50021;" edge="1" parent="1" source="s3-d" target="s3-a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="seq-note3" value="Bad dates / unauthorized requests fail. Separate activity CSV uses activity + optional search." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#292929;strokeColor=#A50021;fillColor=#FFFDF8;text;strokeColor=none;fillColor=none;align=left;fontSize=19;" vertex="1" parent="1">
          <mxGeometry x="1530" y="1970" width="1400" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
