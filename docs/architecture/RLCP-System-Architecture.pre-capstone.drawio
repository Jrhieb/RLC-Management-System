          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dep-web-files" value="Read/write&#10;files" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#252525;fontColor=#252525;fontSize=16;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="dep-windows-host" source="dep-web-process" target="dep-file-storage">
