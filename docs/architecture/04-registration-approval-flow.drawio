          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="notes" value="Failure branches: invalid/expired/used link or session -&gt; registration error. Duplicate email -&gt; validation / unique constraint. Queue or delivery failure -&gt; invalidate link; sanitized failure. No real tokens are documented." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#252525;fontColor=#252525;fontSize=20;spacing=12;verticalAlign=middle;fillColor=#FFF9EF;strokeColor=#D4A039;align=left;fontSize=19;" vertex="1" parent="1">
