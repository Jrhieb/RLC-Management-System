        </mxCell>
        <mxCell id="request" value="EmailRegistrationService::requestLink&#10;Existing email: no-op job&#10;Otherwise upsert request + hash&#10;Inside transaction" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#252525;fontColor=#252525;fontSize=20;spacing=12;verticalAlign=middle;" vertex="1" parent="1">
