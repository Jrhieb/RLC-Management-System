          <mxGeometry as="geometry" x="40" y="25" width="1520" height="65" />
        </mxCell>
        <mxCell id="takeaway" value="A one-use email link becomes a short-lived registration session before a pending account is created." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#252525;fontColor=#252525;fontSize=20;spacing=12;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=21;align=left;" vertex="1" parent="1">
