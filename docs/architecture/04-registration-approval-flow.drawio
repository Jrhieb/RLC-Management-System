          <mxGeometry as="geometry" x="1180" y="200" width="350" height="170" />
        </mxCell>
        <mxCell id="complete" value="POST /register/complete&#10;Atomically consume session&#10;Create verified pending Caseworker&#10;Notify Directors; await approval" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#252525;fontColor=#252525;fontSize=20;spacing=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="460" width="350" height="170" />
        </mxCell>
        <mxCell id="verify" value="GET /register/verify/{token}&#10;Atomic link consumption&#10;Create session hash + expiry&#10;Redirect to completion form" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#252525;fontColor=#252525;fontSize=20;spacing=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="460" width="350" height="170" />
        </mxCell>
