        <mxCell id="note" value="Verified: creator and recorder FKs also point to User (omitted repeated arrows for clarity).&#10;Beneficiary/activity deletion restricted by attendance; beneficiary deletion restricted by assistance.&#10;User references null on delete. Soft archive retains history. All fields are schema names only." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#252525;fontColor=#252525;fontSize=20;spacing=12;verticalAlign=middle;fillColor=#FFF9EF;fontSize=18;" vertex="1" parent="1">
